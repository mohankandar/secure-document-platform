<?xml version="1.0" encoding="UTF-8"?>
<!-- The harness prints its own progress (ids and numbers). Product log lines are value-free, but only
     warnings and errors are shown, to keep the console readable. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{20} %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
