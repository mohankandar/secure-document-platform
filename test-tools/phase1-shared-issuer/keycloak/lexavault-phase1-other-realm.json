{
  "realm": "lexavault-phase1-other",
  "displayName": "LexaVault Phase 1 wrong-issuer realm (test only)",
  "enabled": true,
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "groups": [
    { "name": "lv-a-staff" }
  ],
  "users": [
    {
      "username": "eve.other",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Eve",
      "lastName": "OtherIssuer",
      "email": "eve.other@phase1.invalid",
      "requiredActions": [],
      "groups": ["/lv-a-staff"]
    }
  ],
  "clients": [
    {
      "clientId": "lexavault-phase1-other-checks",
      "name": "Wrong-issuer refusal check (test only, password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "lexavault-phase1-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lexavault-phase1-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
