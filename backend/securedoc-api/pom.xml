<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.securedoc.platform</groupId>
        <artifactId>securedoc-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>securedoc-api</artifactId>
    <name>SecureDoc - API</name>
    <description>REST API layer with Spring Boot. Runnable local/demo entry point.</description>

    <dependencyManagement>
        <dependencies>
            <!-- Task 0056: Liquibase stays open source (see liquibase.version in the parent pom). Before Spring Boot's BOM, which
                 would bring 5.x. -->
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-worker</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared identity (platform-core platform-identity-spring: OIDC identity normalization, entity admission). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-spring</artifactId>
        </dependency>

        <!-- Task 0037: the idn_ stores. platform-licensing (the licence, read only for identity: slots and the
             development-licence check; nothing counted or enforced; task 0041) comes with identity-jdbc and is named
             here because the demo step reads the licence. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing</artifactId>
        </dependency>
        <!-- Task 0057: the stored licence checked at start, enforced at intake (PlatformLicence) and metered. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing-spring</artifactId>
        </dependency>
        <!-- Task 0057: the dependency checks, the start-up refusal, references and the diagnostic bundle. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-monitoring-spring</artifactId>
        </dependency>
        <!-- Task 0059: notifications and the one-click approval links. Its mail sender needs the mail library that task
             0057 left out: angus-mail with jakarta.mail-api, and their activation libraries. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-notifications-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-notifications</artifactId>
        </dependency>
        <!-- Task 0060: the key service and the stream cipher (platform.crypto.*), the erase log and its start-up guard
             (platform.erase-log.*). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-erase-log-spring</artifactId>
        </dependency>
        <!-- Task 0061: case fields (the app builds the field objects itself; there is no Spring module). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-fields</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-fields-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-erase-log-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Task 0041: the setup command runs from its own jar (securedoc-setup), which the app's classpath may not carry (task 0041). Here only for the tests that
             run setup before the demo step. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-setup</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Task 0054: the mock login server for the test sign-in, and the in-memory identity store. Tests only. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-testkit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Task 0037: the schema step runs the platform Flyway runs (db/platform/identity, db/platform/licensing), each
             with its own history table. Never at startup: spring.flyway.enabled is false in application.yml. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Structured JSON console logging for SaaS/production. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>

        <!-- Production identity / API security (Unit 25) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator (optional, for health/readiness) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Focused Unit 25 security-boundary tests only. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Task 0054: the licence keys this build trusts (SEC-12; see licence.build in the parent pom). -->
            <resource>
                <directory>${project.basedir}/../licence-build/${licence.build}</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/platform/licence-keys.json</include>
                    <include>META-INF/platform/licence-build.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
