<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.securedoc.platform</groupId>
        <artifactId>securedoc-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>securedoc-api</artifactId>
    <name>SecureDoc - API</name>
    <description>REST API layer with Spring Boot. Runnable local/demo entry point.</description>

    <properties>
        <spring-boot.version>3.3.2</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Keep the Jackson family aligned on one patched line. This import must precede
                 Spring Boot's BOM because Maven uses the first imported BOM on version conflicts. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-worker</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared identity (platform-core platform-identity-spring: OIDC identity normalization, entity admission). -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-spring</artifactId>
        </dependency>

        <!-- Task 0037: the idn_ stores. platform-licensing (the licence, read only for identity: slots and the
             development-licence check; nothing counted or enforced; task 0041) comes with identity-jdbc and is named
             here because the demo step reads the licence. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-licensing</artifactId>
        </dependency>
        <!-- Task 0041: the setup command runs from its own jar (securedoc-setup), because it brings platform-crypto and
             platform-integration, which the app's classpath may not carry (task 0041). Here only for the tests that
             run setup before the demo step. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-setup</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Task 0037: the schema step runs the platform Flyway runs (db/platform/identity, db/platform/licensing), each
             with its own history table. Never at startup: spring.flyway.enabled is false in application.yml. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Structured JSON console logging for SaaS/production. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- Production identity / API security (Unit 25) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator (optional, for health/readiness) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Focused Unit 25 security-boundary tests only. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
