<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.securedoc.platform</groupId>
        <artifactId>securedoc-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>securedoc-setup</artifactId>
    <name>SecureDoc - Setup wrapper</name>
    <description>
        Task 0041: platform-core's setup command (com.documentplatform.setup.SetupCommand) in its own runnable jar.
        Setup brings platform-crypto and platform-integration (customer keys, integration profile checks); the app's
        classpath may not carry them (task 0041), so setup is not run from the app jar. No LexaVault code here: the
        scripts pass install/product-roles.json as an argument. The licence keys it trusts are inside this jar (task
        0054, SEC-12): META-INF/platform, see licence.build in the parent pom.
    </description>

    <properties>
        <spring-boot.version>3.3.2</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Task 0054: as in securedoc-api. -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>${httpclient5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.core5</groupId>
                <artifactId>httpcore5-h2</artifactId>
                <version>${httpcore5.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-setup</artifactId>
        </dependency>
        <!-- The JDBC driver setup connects with (PLATFORM_SETUP_DB_URL); the same driver and version as the app. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Task 0054: the licence keys this build trusts (SEC-12; see licence.build in the parent pom). -->
            <resource>
                <directory>${project.basedir}/../licence-build/${licence.build}</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/platform/licence-keys.json</include>
                    <include>META-INF/platform/licence-build.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.documentplatform.setup.SetupCommand</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
