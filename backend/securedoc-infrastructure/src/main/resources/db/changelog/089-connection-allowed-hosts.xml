<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Hardening (task 0110, approved by the task): outbound addresses limited. The host names the IT Administrator
        allows a connection to reach although they are internal or plain http. Empty for every existing connection.
        Included before 044 (after the table exists), not at the end, so the roll-back tests that count change sets
        from the end are unchanged.
    -->
    <changeSet id="089-01-connection-allowed-hosts" author="lexavault">
        <addColumn tableName="integration_connections">
            <column name="allowed_hosts" type="VARCHAR(2000)"
                    remarks="Host names the IT Administrator allows this connection to reach although internal or plain http, comma-separated, empty for none."/>
        </addColumn>
        <rollback>
            <dropColumn tableName="integration_connections" columnName="allowed_hosts"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
