<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ==================== TENANTS ==================== -->
    <changeSet id="001-01-create-tenants" author="securedoc">
        <createTable tableName="tenants">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ==================== TENANT CAPABILITIES ==================== -->
    <changeSet id="001-02-create-tenant-capabilities" author="securedoc">
        <createTable tableName="tenant_capabilities">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="capability" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="tenant_capabilities" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_tenant_capabilities_tenant"/>
        <addUniqueConstraint tableName="tenant_capabilities" columnNames="tenant_id, capability"
                             constraintName="uq_tenant_capability"/>
    </changeSet>

    <!-- ==================== DOCUMENT PACKAGES ==================== -->
    <changeSet id="001-03-create-document-packages" author="securedoc">
        <createTable tableName="document_packages">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="package_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="metadata_json" type="TEXT"/>
            <column name="created_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="document_packages" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_document_packages_tenant"/>
        <createIndex tableName="document_packages" indexName="idx_document_packages_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <!-- ==================== DOCUMENTS ==================== -->
    <changeSet id="001-04-create-documents" author="securedoc">
        <createTable tableName="documents">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="package_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="document_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="mime_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="checksum_algorithm" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="checksum_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="page_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="documents" baseColumnNames="package_id"
                                 referencedTableName="document_packages" referencedColumnNames="id"
                                 constraintName="fk_documents_package"/>
        <addForeignKeyConstraint baseTableName="documents" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_documents_tenant"/>
        <createIndex tableName="documents" indexName="idx_documents_package_id">
            <column name="package_id"/>
        </createIndex>
        <createIndex tableName="documents" indexName="idx_documents_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <!-- ==================== ARTIFACTS ==================== -->
    <changeSet id="001-05-create-artifacts" author="securedoc">
        <createTable tableName="artifacts">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="document_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="artifact_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="storage_provider" type="VARCHAR(100)"/>
            <column name="storage_bucket" type="VARCHAR(255)"/>
            <column name="storage_key" type="VARCHAR(1024)"/>
            <column name="mime_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="size_bytes" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="checksum_algorithm" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="checksum_value" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="artifacts" baseColumnNames="document_id"
                                 referencedTableName="documents" referencedColumnNames="id"
                                 constraintName="fk_artifacts_document"/>
        <addForeignKeyConstraint baseTableName="artifacts" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_artifacts_tenant"/>
        <createIndex tableName="artifacts" indexName="idx_artifacts_document_id">
            <column name="document_id"/>
        </createIndex>
    </changeSet>

    <!-- ==================== AUDIT RECORDS ==================== -->
    <changeSet id="001-06-create-audit-records" author="securedoc">
        <createTable tableName="audit_records">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="actor_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="correlation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="detail" type="TEXT"/>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="audit_records" indexName="idx_audit_records_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="audit_records" indexName="idx_audit_records_correlation_id">
            <column name="correlation_id"/>
        </createIndex>
    </changeSet>

    <!-- ==================== OUTBOX EVENTS ==================== -->
    <changeSet id="001-07-create-outbox-events" author="securedoc">
        <createTable tableName="outbox_events">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="correlation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="payload_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="retry_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="TEXT"/>
        </createTable>
        <createIndex tableName="outbox_events" indexName="idx_outbox_events_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="outbox_events" indexName="idx_outbox_events_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <!-- ==================== PROCESSING LOCKS ==================== -->
    <changeSet id="001-08-create-processing-locks" author="securedoc">
        <createTable tableName="processing_locks">
            <column name="lock_key" type="VARCHAR(512)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="UUID"/>
            <column name="owner_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="fencing_token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
