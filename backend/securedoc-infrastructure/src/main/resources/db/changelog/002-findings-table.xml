<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- ==================== FINDINGS ==================== -->
    <changeSet id="002-01-create-findings" author="securedoc">
        <createTable tableName="findings">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="document_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="page_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="start_offset" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="end_offset" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="confidence" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="detector_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="detector_version" type="VARCHAR(50)"/>
            <column name="snippet" type="VARCHAR(255)">
                <!-- Masked preview only — never raw sensitive value -->
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="detected_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="findings" baseColumnNames="document_id"
                                 referencedTableName="documents" referencedColumnNames="id"
                                 constraintName="fk_findings_document"/>
        <createIndex tableName="findings" indexName="idx_findings_document_id">
            <column name="document_id"/>
        </createIndex>
        <createIndex tableName="findings" indexName="idx_findings_entity_type">
            <column name="entity_type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
