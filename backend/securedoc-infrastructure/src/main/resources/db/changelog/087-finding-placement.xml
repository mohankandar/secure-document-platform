<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Task 0105 (owner approved): how each finding was read, found and placed, on the finding itself, so a plain query
        shows where work and misses come from. Kinds and names only, never a value. Findings saved before this task keep
        what they have; these columns are empty for them.

        Included after 086 in the master changelog, not at its end, so the roll-back tests that count change sets from the
        end need no new count.
    -->
    <changeSet id="087-01-finding-placement" author="lexavault">
        <addColumn tableName="findings">
            <column name="reader" type="VARCHAR(16)"/>
            <column name="method" type="VARCHAR(16)"/>
            <column name="placement" type="VARCHAR(24)"/>
            <column name="person_reason" type="VARCHAR(48)"/>
            <column name="placed_by" type="UUID"/>
            <column name="placed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="findings" columnName="placed_at"/>
            <dropColumn tableName="findings" columnName="placed_by"/>
            <dropColumn tableName="findings" columnName="person_reason"/>
            <dropColumn tableName="findings" columnName="placement"/>
            <dropColumn tableName="findings" columnName="method"/>
            <dropColumn tableName="findings" columnName="reader"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
