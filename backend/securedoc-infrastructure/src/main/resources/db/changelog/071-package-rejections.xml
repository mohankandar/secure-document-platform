<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Task 0071 (BL8): why a person rejected a case, as an LV code. One row per case; never free text. -->
    <changeSet id="071-01-package-rejections" author="lexavault">
        <createTable tableName="package_rejections">
            <column name="package_id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="reason_code" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="rejected_by" type="UUID"><constraints nullable="false"/></column>
            <column name="rejected_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="package_rejections" baseColumnNames="package_id"
                                 referencedTableName="document_packages" referencedColumnNames="id"
                                 constraintName="fk_package_rejections_package"/>
        <addForeignKeyConstraint baseTableName="package_rejections" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_package_rejections_tenant"/>
        <rollback>
            <dropTable tableName="package_rejections"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
