<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Task 0073 (owner approved): a case's priority (no row: NORMAL) and the default of a source. Not a column of
        document_packages: processing writes that whole row and would undo a reviewer's change.
        source_key: an integration connection's id, or folder:<key> for a watched folder.
    -->
    <changeSet id="082-01-case-priority" author="lexavault">
        <createTable tableName="case_priorities">
            <column name="package_id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="priority" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="case_priorities" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_case_priorities_tenant"/>
        <createTable tableName="source_priorities">
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="source_key" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="priority" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="source_priorities" columnNames="tenant_id,source_key"
                       constraintName="pk_source_priorities"/>
        <addForeignKeyConstraint baseTableName="source_priorities" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_source_priorities_tenant"/>
        <sql>
            alter table case_priorities add constraint ck_case_priorities_priority
                check (priority in ('URGENT', 'NORMAL', 'LOW'));
            alter table source_priorities add constraint ck_source_priorities_priority
                check (priority in ('URGENT', 'NORMAL', 'LOW'));
        </sql>
        <rollback>
            <dropTable tableName="source_priorities"/>
            <dropTable tableName="case_priorities"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
