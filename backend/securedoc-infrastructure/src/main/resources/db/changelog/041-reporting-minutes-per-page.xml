<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Task 0020 B2 (build plan step 7, owner approved): the minutes a person would take to check one page by hand,
        used for "Review time saved (estimate)". Default 1.0, deliberately low. Allowed 0.5 to 30 in steps of 0.5;
        the application checks the steps, the database the range. Existing tenants get the default.
    -->
    <changeSet id="041-01-reporting-minutes-per-page" author="securedoc">
        <addColumn tableName="reporting_tenant_settings">
            <column name="minutes_per_page" type="NUMERIC(4,1)" defaultValueNumeric="1.0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            alter table reporting_tenant_settings
                add constraint ck_reporting_minutes_per_page
                check (minutes_per_page between 0.5 and 30)
        </sql>
        <rollback>
            <dropColumn tableName="reporting_tenant_settings" columnName="minutes_per_page"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
