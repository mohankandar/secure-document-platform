<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Task 0067 (owner approved). Numbers only, for the whole installation:
        - ai_server_limits: the requests at once learned per AI server (its scheme, host and port; no user name, no path).
        - capacity_maximums: IT's own maximum per stage, and of AI requests at once.
    -->
    <changeSet id="081-01-processing-capacity" author="lexavault">
        <createTable tableName="ai_server_limits">
            <column name="server" type="VARCHAR(300)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="learned_limit" type="INTEGER"><constraints nullable="false"/></column>
            <column name="learned_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <createTable tableName="capacity_maximums">
            <column name="name" type="VARCHAR(32)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="maximum" type="INTEGER"><constraints nullable="false"/></column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <sql>
            alter table ai_server_limits add constraint ck_ai_server_limits_limit
                check (learned_limit between 1 and 64);
            alter table capacity_maximums add constraint ck_capacity_maximums_maximum
                check (maximum between 1 and 64);
        </sql>
        <rollback>
            <dropTable tableName="capacity_maximums"/>
            <dropTable tableName="ai_server_limits"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
