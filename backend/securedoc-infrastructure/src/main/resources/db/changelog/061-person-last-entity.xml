<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Task 0058 (owner approved the migrations the task needs): the entity a person worked in last, one row per person, so
        the next sign-in lands there. Ids and a time only. It is a convenience: it never gives access, every sign-in and
        every request is checked against the person's groups as before.
    -->
    <changeSet id="061-01-person-last-entity" author="lexavault">
        <createTable tableName="person_last_entity">
            <column name="actor_id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="UUID"><constraints nullable="false"/></column>
            <column name="chosen_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="person_last_entity" baseColumnNames="tenant_id"
                                 referencedTableName="tenants" referencedColumnNames="id"
                                 constraintName="fk_person_last_entity_tenant"/>
        <rollback>
            <dropTable tableName="person_last_entity"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
