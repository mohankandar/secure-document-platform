<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.securedoc.platform</groupId>
        <artifactId>securedoc-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>securedoc-infrastructure</artifactId>
    <name>SecureDoc - Infrastructure</name>
    <description>Infrastructure adapters (persistence, storage, messaging). Uses Spring Data JPA, PostgreSQL, Liquibase.</description>

    <dependencyManagement>
        <dependencies>
            <!-- Task 0056: Liquibase stays open source (see liquibase.version in the parent pom). Before Spring Boot's BOM, which
                 would bring 5.x. -->
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-core</artifactId>
        </dependency>
        <!-- Task 0087: delivery to a destination through its published profile. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-integration-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Task 0060: stored files encrypted with the customer's keys, and the erase log with its handlers. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-erase-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-fields</artifactId>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-fields-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-crypto-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-erase-log-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Task 0037: the idn_ stores (PostgresIdentityLookup, PostgresMachineEntityBindings) behind the sign-in reads. -->
        <dependency>
            <groupId>com.documentplatform.platform</groupId>
            <artifactId>platform-identity-jdbc</artifactId>
        </dependency>
        <!-- Internal modules -->
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.securedoc.platform</groupId>
            <artifactId>securedoc-application</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Liquibase -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <version>${liquibase.version}</version>
        </dependency>
        <!-- Spring Boot 4: the Liquibase run at start (LOCAL) is a module of its own. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-liquibase</artifactId>
        </dependency>

        <!-- Jackson for safe JSON serialization (outbox, metadata) -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- PDFBox for local/demo PDF text extraction -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- ZXing for deterministic fixed-region barcode / QR routing markers -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>
    </dependencies>
</project>
