<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.securedoc.platform</groupId>
    <artifactId>securedoc-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SecureDoc Platform - Parent</name>
    <description>Secure document intelligence, redaction, human review, vault, and audit platform</description>

    <modules>
        <module>securedoc-domain</module>
        <module>securedoc-ai</module>
        <module>securedoc-agent</module>
        <module>securedoc-scan-bridge</module>
        <module>securedoc-redaction</module>
        <module>securedoc-application</module>
        <module>securedoc-infrastructure</module>
        <module>securedoc-worker</module>
        <module>securedoc-api</module>
        <module>securedoc-setup</module>
        <module>securedoc-test-support</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- platform-core, one released version for all platform-* modules (task 0094: v1.1.0, tag platform-core-v1.1.0),
             read from GitHub Packages (repository github-platform-core below; docs/install/BUILD.md). -->
        <platform.version>1.1.0</platform.version>
        <!-- Task 0054 (platform-core 0.7.0, SEC-12): the licence keys a build trusts are inside its jars, from
             backend/licence-build/<licence.build>/META-INF/platform (securedoc-api and securedoc-setup; docs/install/BUILD.md).
             production is the default and carries no development key; only -Pdev-build does. -->
        <licence.build>production</licence.build>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <licence.built-at>${maven.build.timestamp}</licence.built-at>
        <!-- Task 0056: one Spring Boot line for every module that uses it. -->
        <spring-boot.version>4.2.0</spring-boot.version>
        <!-- Jackson 3 at the version Spring Boot manages, named for securedoc-ai, which does not import its BOM. -->
        <jackson.version>3.1.8</jackson.version>
        <!-- Open source (Apache-2.0). Spring Boot 4.2 manages 5.0.4, which is FSL-1.1-ALv2 (not open source); 4.30 and later
             report usage to the vendor unless switched off, so this is the last release that does not. -->
        <liquibase.version>4.29.2</liquibase.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- Task 0041: platform-core releases are published to GitHub Packages. Reading them needs the server
         github-platform-core in your own ~/.m2/settings.xml (username and ${env.GITHUB_PACKAGES_TOKEN}, a token with
         read:packages); see docs/install/BUILD.md. Only releases: no snapshots from there. -->
    <repositories>
        <repository>
            <id>github-platform-core</id>
            <url>https://maven.pkg.github.com/mohankandar/platform-core</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.documentplatform.platform</groupId>
                <artifactId>platform-bom</artifactId>
                <version>${platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Task 0054: the development build (local machines, demos, test tools). It trusts the development key of
             install/demo/development-trusted-keys.json. Never for a build that goes to a customer. -->
        <profile>
            <id>dev-build</id>
            <properties>
                <licence.build>dev</licence.build>
            </properties>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Pin Surefire for every module. Without this, modules that do not pin it
                     fall back to Maven's default Surefire, which does not detect JUnit 5. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <release>${java.version}</release>
                    <parameters>true</parameters>
                    <!-- This project is not JPMS-modular. Keep reactor/test compilation on the classpath. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
