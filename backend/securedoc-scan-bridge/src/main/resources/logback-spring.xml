<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="securedoc-scan-bridge"/>
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"${serviceName}"}</customFields>
            <includeContext>false</includeContext>
            <includeCallerData>false</includeCallerData>
            <!-- Task 0056: Spring 7 marks its own lines; without this they would carry "tags":["COMMONS-LOGGING"]. -->
            <includeTags>false</includeTags>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
